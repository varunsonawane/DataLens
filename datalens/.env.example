# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# GCS Buckets
GCS_BUCKET_SESSIONS=datalens-sessions
GCS_BUCKET_IMAGES=datalens-images

# Vertex AI Vector Search
VERTEX_AI_INDEX_ENDPOINT=projects/PROJECT_ID/locations/us-central1/indexEndpoints/INDEX_ENDPOINT_ID
VERTEX_AI_INDEX_ID=datalens-rag-index
VERTEX_AI_INDEX_ENDPOINT_ID=your-index-endpoint-id
VERTEX_AI_DEPLOYED_INDEX_ID=datalens-rag-deployed

# Firestore
FIRESTORE_COLLECTION=sessions
FIRESTORE_DATABASE=(default)

# FastAPI Backend
BACKEND_PORT=8080
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
MAX_UPLOAD_SIZE_MB=100

# Google GenAI SDK
GENAI_API_KEY=your-api-key-if-not-using-adc

# Frontend (Vite env vars must be prefixed with VITE_)
VITE_BACKEND_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
VITE_APP_TITLE=DataLens

# Cloud Run (set by deployment)
CLOUD_RUN_SERVICE_NAME=datalens-backend
CLOUD_RUN_REGION=us-central1

# Session Config
SESSION_TTL_DAYS=30
MAX_IMAGES_PER_SESSION=20
