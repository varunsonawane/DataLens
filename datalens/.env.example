# --- MANDATORY: Google Cloud Configuration ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option A: Using Application Default Credentials (recommended)
# Run 'gcloud auth application-default login' on your machine.
# Option B: Using a Service Account JSON
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json

# --- Persistence: Cloud vs. Local ---
# Set GCS_LOCAL_DEV=true to use local filesystem instead of GCS/Firestore.
GCS_LOCAL_DEV=false

# GCS Buckets (Mandatory if GCS_LOCAL_DEV=false)
GCS_BUCKET_SESSIONS=datalens-sessions
GCS_BUCKET_IMAGES=datalens-images

# Vertex AI Vector Search (Optional: app falls back to in-memory store if index is missing)
# VERTEX_AI_INDEX_ENDPOINT=projects/PROJECT_ID/locations/us-central1/indexEndpoints/INDEX_ENDPOINT_ID
# VERTEX_AI_INDEX_ID=datalens-rag-index
# VERTEX_AI_INDEX_ENDPOINT_ID=your-index-endpoint-id
# VERTEX_AI_DEPLOYED_INDEX_ID=datalens-rag-deployed

# Firestore (Mandatory if GCS_LOCAL_DEV=false)
FIRESTORE_COLLECTION=sessions
FIRESTORE_DATABASE=(default)
FIRESTORE_USERS_COLLECTION=users

# --- Backend Configuration ---
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
MAX_UPLOAD_SIZE_MB=100
LOG_LEVEL=INFO
LOCAL_BACKEND_URL=http://localhost:8000

# Google GenAI SDK & Live Model
# Only needed if NOT using ADC or Vertex AI
GENAI_API_KEY=your-api-key-if-not-using-adc
GOOGLE_API_KEY=your-google-api-key-optional
DATALENS_LIVE_MODEL=gemini-2.5-flash

# --- Auth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# --- Frontend Configuration (Vite env vars must be prefixed with VITE_) ---
VITE_BACKEND_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
VITE_APP_TITLE=DataLens

# --- Session Config ---
SESSION_TTL_DAYS=30
MAX_IMAGES_PER_SESSION=20
